{
  "manifest_version":3,
  "name":"FH6 YouTube Aktarımı",
  "version":"0.6.1",
  "minimum_chrome_version":"116",
  "description":"Seçtiğin YouTube videosunu altyazıları ve mevcut ayarlarıyla ETS2 kabin ekranlarına aktarır.",
  "permissions":["activeTab","scripting","tabCapture","offscreen","storage"],
  "host_permissions":["http://127.0.0.1/*"],
  "background":{"service_worker":"service-worker.js"},
  "action":{"default_popup":"popup.html","default_title":"FH6 YouTube Aktarımı"},
  "content_security_policy":{"extension_pages":"script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:32127"}
}
