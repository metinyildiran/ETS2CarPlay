{
  "manifest_version":3,
  "name":"ETS2 Video Aktarımı",
  "version":"0.7.1",
  "minimum_chrome_version":"116",
  "description":"Seçtiğin tarayıcı videosunu veya sayfa alanını ETS2 kabin ekranlarına aktarır.",
  "permissions":["activeTab","scripting","tabCapture","offscreen","storage"],
  "host_permissions":["http://127.0.0.1/*"],
  "background":{"service_worker":"service-worker.js"},
  "action":{"default_popup":"popup.html","default_title":"ETS2 Video Aktarımı"},
  "content_security_policy":{"extension_pages":"script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:32127"}
}
